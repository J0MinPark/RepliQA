{
  "name": "repliqa-mcp-server",
  "version": "1.0.0",
  "description": "MCP server that lets Claude Code/Cursor trigger RepliQA QA runs and read results directly",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "repliqa-mcp": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "build": "esbuild src/index.js --bundle --platform=node --format=esm --outfile=dist/repliqa-mcp.bundle.mjs && node -e \"require('fs').copyFileSync('dist/repliqa-mcp.bundle.mjs', '../frontend/public/repliqa-mcp.bundle.mjs')\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
