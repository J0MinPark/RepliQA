# Gemini (Vision) API 키 — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 선택 — 하이브리드 그라운딩. 설정하면 클릭 대상 좌표를 OpenRouter의 UI-TARS(GUI 그라운딩
# 전용 오픈소스 모델)로 다시 확인해서 Gemini의 시각-매칭 실수를 보정한다(요소가 많고 비슷한
# 화면에서 자주 발생 — 네이버 사례로 확인함). https://openrouter.ai 가입 후 발급.
# 비워두면 기존처럼 Gemini의 elementIndex 판단만으로 동작(그대로 잘 작동함, 순수 추가 기능).
OPENROUTER_API_KEY=

# 로컬 개발은 기본적으로 Firebase Local Emulator Suite를 쓴다 (실제 클라우드 프로젝트 불필요).
# 운영 배포 시 false로 바꾸고 GOOGLE_APPLICATION_CREDENTIALS로 서비스 계정을 지정하세요.
FIREBASE_USE_EMULATOR=true
FIREBASE_PROJECT_ID=repliqa-dev
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
FIREBASE_STORAGE_BUCKET=repliqa-dev.appspot.com

# 프론트엔드 origin (CORS 화이트리스트)
FRONTEND_ORIGIN=http://localhost:5173

# 테스트 계정 자격증명 암호화 키 — `openssl rand -base64 32`로 생성
CREDENTIAL_ENCRYPTION_KEY=

# 스크린샷 저장소(Supabase Storage) — 운영 배포 시 필수. 2026-02부터 Firebase Storage는
# Blaze(카드 등록) 없이는 못 써서, 카드 없이 되는 Supabase로 대체함(screenshotStore.js).
# 로컬 개발은 비워두면 지금까지처럼 Firebase Storage 에뮬레이터를 그대로 씀.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCREENSHOT_BUCKET=screenshots

# API 서버 포트 (비워두면 3001 기본값 — 워커도 같은 .env를 읽으므로 여기서 값을 지정하면
# 워커의 헬스체크 서버(PORT 감지 시에만 켜짐, worker.js 참고)와 포트가 충돌한다. Render에
# 배포된 워커는 플랫폼이 PORT를 직접 주입하므로 이 파일과 무관하게 정상 동작한다.
# PORT=3001

# 워커 동시 실행 브라우저 컨텍스트 수 / 폴링 주기(ms)
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=3000

# 파일럿/고객 조사 단계 전용 — 기본값 true(미설정 시에도 true, env.js 참고). 지인 소유
# 사이트 등 소유권 검증이 오히려 진입 장벽인 지금 단계를 위한 것. true면 URL 등록 즉시
# "검증하기"를 누르는 순간 실제 .well-known 파일 확인 없이 통과됨.
# 프로덕션/외부 사용자 대상으로 여는 시점엔 반드시 false로 바꿀 것.
SKIP_OWNERSHIP_VERIFICATION=true
