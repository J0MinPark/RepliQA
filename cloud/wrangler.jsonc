{
  "name": "repliqa-your-instance",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "browser": {
    "binding": "BROWSER"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NETWORK_RELAY",
        "class_name": "NetworkRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "network-relay-v1",
      "new_sqlite_classes": [
        "NetworkRelay"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "repliqa-your-instance",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "FREE_PLAN_CONFIRMED": "false",
    "CLOUD_AI_ENABLED": "false"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "observability": {
    "enabled": false
  }
}